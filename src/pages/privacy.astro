---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../config";
---

<MainLayout
  title={`Privacy Policy | ${SITE.name}`}
  description={`How ${SITE.name} handles information when you visit this website or contact us.`}
>
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900">Privacy policy</h1>
      <p class="mt-4 text-sm text-gray-500">Last updated: {SITE.privacyUpdated}</p>

      <div class="mt-12 space-y-10 text-gray-700 leading-8">

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Who we are</h2>
          <p class="mt-3">
            This website is operated by {SITE.legalName} ("we", "us"). If you have questions about this policy,
            write to us at
            <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">{SITE.email}</a>.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Information we collect</h2>
          <p class="mt-3">
            This site does not have accounts, sign-up forms, or a checkout. We do not ask you to enter personal
            information on the site itself.
          </p>
          <ul class="mt-3 list-disc pl-6 space-y-2">
            <li>
              <span class="font-medium text-gray-900">Messages you send us.</span> If you email us, we receive
              your email address, name (if shown), and whatever you choose to include in your message.
            </li>
            <li>
              <span class="font-medium text-gray-900">Server logs.</span> Our hosting provider may automatically
              record technical data when pages are requested, such as IP address, browser type, pages requested, and
              date and time. This is standard for web hosting and is used for security and reliability.
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Cookies and analytics</h2>
          <p class="mt-3">
            This site does not currently set cookies or use analytics or advertising trackers. If we add analytics
            in the future, we will update this page to say what is collected and why.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">How we use information</h2>
          <p class="mt-3">
            We use messages you send to respond to you and to discuss potential collaborations, evaluations, or
            partnerships. We do not sell your personal information, and we do not use it for advertising.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Sharing</h2>
          <p class="mt-3">
            We share information only with service providers who help us run the site and our email (such as web
            hosting and email providers), or where required by law. Those providers may process data on our behalf.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Retention</h2>
          <p class="mt-3">
            We keep correspondence for as long as needed to respond and to maintain a record of our business
            relationships, and then delete it when it is no longer needed.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Your choices</h2>
          <p class="mt-3">
            You can ask us what information we hold about you, or ask us to correct or delete it, by emailing
            <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">{SITE.email}</a>.
            Depending on where you live, you may have additional rights under local privacy law.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Links to other sites</h2>
          <p class="mt-3">
            This site may link to other websites. We are not responsible for their content or privacy practices.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900">Changes to this policy</h2>
          <p class="mt-3">
            If we change this policy, we will post the updated version here and change the date at the top.
          </p>
        </div>

      </div>
    </div>
  </section>
</MainLayout>
