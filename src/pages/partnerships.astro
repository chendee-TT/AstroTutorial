---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../config";

const partners = [
  {
    name: "Research institutions",
    body: "Joint work on sensing architectures, contact modeling, and manipulation research that benefits from high-resolution interaction data.",
  },
  {
    name: "Industry partners",
    body: "Evaluation and integration of our sensing platform in robotics, automation, and handling systems where contact behavior matters.",
  },
  {
    name: "Public-sector programs",
    body: "Participation in funded research and development programs focused on advancing sensing for physical interaction.",
  },
];

const interests = [
  "Advanced robotics",
  "Experimental sensing architectures",
  "Systems requiring high-resolution measurement of force, pressure, and shear dynamics",
];
---

<MainLayout
  title={`Partnerships | ${SITE.name}`}
  description="Tactonic Technologies works with research institutions, industry partners, and public-sector programs to advance physical interaction sensing."
>

  <section class="border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-gray-500">Partnerships</p>
        <h1 class="mt-6 text-5xl md:text-6xl font-bold tracking-tight text-gray-900 leading-tight">
          Advancing physical interaction sensing through collaboration.
        </h1>
        <p class="mt-8 text-xl text-gray-600 leading-8">
          We work with research institutions, industry partners, and public-sector programs to explore and advance sensing systems for real-time physical interaction understanding.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-sm uppercase tracking-[0.2em] text-gray-500">Who we work with</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-8">
        {partners.map((p) => (
          <div class="border border-gray-200 rounded-2xl p-8">
            <h3 class="text-xl font-semibold text-gray-900">{p.name}</h3>
            <p class="mt-4 text-gray-600 leading-7">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 border-y border-gray-200 py-24">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16">
      <div>
        <h2 class="text-sm uppercase tracking-[0.2em] text-gray-500">Areas of interest</h2>
        <p class="mt-4 text-4xl font-bold text-gray-900 leading-tight">
          We are particularly interested in collaborations involving:
        </p>
      </div>
      <ul class="space-y-4 text-lg text-gray-700 leading-8 list-disc pl-6 self-center">
        {interests.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="bg-gray-900 text-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-4xl font-bold leading-tight">Start a conversation.</p>
        <p class="mt-6 text-lg text-gray-300 leading-8">
          Tell us about your organization and what you would like to explore together.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent("Partnership inquiry")}`}
            class="bg-white text-black px-6 py-3 rounded-lg"
          >
            Email us about a partnership
          </a>
          <a href="/applications" class="border border-gray-600 px-6 py-3 rounded-lg">Applications</a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>
